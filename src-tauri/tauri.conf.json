{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marunda",
  "version": "../package.json",
  "identifier": "com.marunda.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Marunda",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "signingIdentity": "-"
    },
    "copyright": "Copyright (c) 2026 Marunda contributors. MIT License.",
    "shortDescription": "Find and clean up node_modules folders",
    "longDescription": "Marunda finds every node_modules folder on your machine, shows how much disk space each one uses, and lets you delete the ones you no longer need."
  }
}
